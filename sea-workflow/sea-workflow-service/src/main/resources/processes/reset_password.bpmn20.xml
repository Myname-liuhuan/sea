<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="reset_password_definitions"
             targetNamespace="http://sea.example.com/workflow/reset-password">

    <process id="reset_password" name="重置密码审批流程" isExecutable="true">

        <!-- 流程变量约定：
             applicantId       : 申请人 user_id (Long)
             targetUserId      : 重置目标 user_id (Long)
             targetUserLevel   : 目标用户能级 (Integer)
             reason            : 申请原因 (String)
             urgency           : 紧急程度 1 普通 / 2 紧急 (Integer)
             approved          : 审批结果 (Boolean, 由审批人 complete 时回填)
             comment           : 审批意见 (String)
             delegatedFrom     : 转交来源 (Long, 可空)
             executionDone     : 执行节点完成标记 (String, "true")
        -->

        <startEvent id="start" name="用户提交申请"/>

        <sequenceFlow id="flow_start_to_dept" sourceRef="start" targetRef="dept_leader"/>

        <userTask id="dept_leader" name="部门主管审批"
                  flowable:assignee="${deptLeaderId}"
                  flowable:candidateGroups="dept_${targetDeptId}">
            <documentation>审批人由监听器从 sys_user.leader_id 解析</documentation>
        </userTask>

        <exclusiveGateway id="needsHr" name="是否需要 HR 复审"/>

        <sequenceFlow id="flow_dept_to_gateway" sourceRef="dept_leader" targetRef="needsHr"/>

        <sequenceFlow id="flow_to_hr"
                      sourceRef="needsHr"
                      targetRef="hr_review">
            <conditionExpression xsi:type="tFormalExpression">${targetUserLevel >= 8}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_skip_hr"
                      sourceRef="needsHr"
                      targetRef="execute_reset">
            <conditionExpression xsi:type="tFormalExpression">${targetUserLevel &lt; 8}</conditionExpression>
        </sequenceFlow>

        <userTask id="hr_review" name="HR 复审"
                  flowable:candidateGroups="role_HR">
            <documentation>role_code='HR' 角色组的所有 HR 都可处理，多实例由解析器控制</documentation>
        </userTask>

        <sequenceFlow id="flow_hr_to_exec" sourceRef="hr_review" targetRef="execute_reset"/>

        <serviceTask id="execute_reset" name="执行密码重置"
                     flowable:delegateExpression="${passwordResetDelegate}"/>

        <sequenceFlow id="flow_exec_to_end" sourceRef="execute_reset" targetRef="end"/>

        <endEvent id="end" name="流程结束"/>

    </process>

</definitions>
